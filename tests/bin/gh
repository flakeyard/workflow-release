#!/usr/bin/env bash
# Stub of gh for tests.
#
# GET PATH is answered from $FIXTURES/<key>, where <key> is PATH with "/",
# "?", "&" and "=" replaced by "_"; with --paginate, $FIXTURES/<key>.2,
# <key>.3 and so on are further pages. A missing file is HTTP 404, and a file
# containing "HTTP 500" is a server error; like gh, errors print the error body
# on stdout and the message on stderr.
#
# Other methods and "gh workflow run" are appended to $CALLS and succeed,
# unless "<METHOD> <PATH>" is listed in $FAIL_ON (one per line), which fails
# with HTTP 502.
set -euo pipefail

key() { echo "${1//[\/?&=]/_}"; }

# fail STATUS MESSAGE: fail like gh does on an HTTP error.
fail() {
  printf '{"message":"%s","status":"%s"}\n' "$2" "$1"
  echo "gh: $2 (HTTP $1)" >&2
  exit 1
}

if [[ $1 == workflow ]]; then
  shift
  echo "workflow $*" >>"$CALLS"
  exit 0
fi
[[ $1 == api ]] || {
  echo "stub gh: unsupported: $*" >&2
  exit 2
}
shift

method="" path="" jq_filter="" paginate=false fields=()
while (($#)); do
  case $1 in
    -X)
      method=$2
      shift 2
      ;;
    --jq | -q)
      jq_filter=$2
      shift 2
      ;;
    -f | -F)
      fields+=("$2")
      shift 2
      ;;
    --paginate)
      paginate=true
      shift
      ;;
    --silent) shift ;;
    -*)
      echo "stub gh: unsupported flag $1" >&2
      exit 2
      ;;
    *)
      path=$1
      shift
      ;;
  esac
done
if [[ -z $method ]]; then
  if ((${#fields[@]})); then method=POST; else method=GET; fi
fi

if [[ $method != GET ]]; then
  echo "$method $path ${fields[*]}" >>"$CALLS"
  if grep -qxF -- "$method $path" <<<"${FAIL_ON:-}"; then
    fail 502 "Bad Gateway"
  fi
  exit 0
fi

file=$FIXTURES/$(key "$path")
[[ -f $file ]] || fail 404 "Not Found"
grep -q 'HTTP 500' "$file" && fail 500 "Server Error"

pages=("$file")
if $paginate; then
  page=2
  while [[ -f $file.$page ]]; do
    pages+=("$file.$page")
    page=$((page + 1))
  done
fi
for page in "${pages[@]}"; do
  if [[ -n $jq_filter ]]; then
    jq -r "$jq_filter" "$page"
  else
    cat "$page"
  fi
done
